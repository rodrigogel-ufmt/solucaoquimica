{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Django no Dev Container",
        "type": "python",
        "request": "attach",
        "connect": {
          "host": "127.0.0.1",
          "port": 5678
        },
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app"
          }
        ],
        "django": true
      }
    ]
  }
  